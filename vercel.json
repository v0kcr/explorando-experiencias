{
  "version": 2,
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/trpc/:path*", "destination": "/api/index.ts" }
  ],
  "cleanUrls": true
}
